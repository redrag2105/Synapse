rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}/keywordHistory/{keywordDocId}
// Fields:
//   keyword: string (1..200)
//   normalizedKeyword: string (1..200)
//   topicId: string | absent (optional OpenAlex topic id)
//   searchCount: int (>= 1)
//   lastSearchedAt: timestamp
//   firstSearchedAt: timestamp
//
// Client queries:
//   orderBy('lastSearchedAt', descending) limit 8
//   orderBy('searchCount', descending) limit 8
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function keywordHistoryKeys() {
      return ['keyword', 'normalizedKeyword', 'topicId', 'searchCount',
              'lastSearchedAt', 'firstSearchedAt'];
    }

    function hasOnlyKeywordHistoryKeys() {
      return request.resource.data.keys().hasOnly(keywordHistoryKeys());
    }

    function isValidKeywordHistoryCreate() {
      let d = request.resource.data;
      return hasOnlyKeywordHistoryKeys()
        && d.keyword is string
        && d.keyword.size() > 0
        && d.keyword.size() <= 200
        && d.normalizedKeyword is string
        && d.normalizedKeyword.size() > 0
        && d.normalizedKeyword.size() <= 200
        && d.searchCount is int
        && d.searchCount == 1
        && d.lastSearchedAt is timestamp
        && d.firstSearchedAt is timestamp
        && (!('topicId' in d) || (d.topicId is string && d.topicId.size() <= 128));
    }

    function isValidKeywordHistoryUpdate() {
      let d = request.resource.data;
      let old = resource.data;
      return hasOnlyKeywordHistoryKeys()
        && d.keyword is string
        && d.keyword.size() > 0
        && d.keyword.size() <= 200
        && d.normalizedKeyword is string
        && d.normalizedKeyword.size() > 0
        && d.searchCount is int
        && d.searchCount == old.searchCount + 1
        && d.lastSearchedAt is timestamp
        && d.firstSearchedAt == old.firstSearchedAt
        && (!('topicId' in d) || (d.topicId is string && d.topicId.size() <= 128));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'appVersion',
            'active',
            'createdAt',
            'updatedAt',
            'lastSeenAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.appVersion is string
          && request.resource.data.active is bool
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.lastSeenAt is timestamp;
        allow delete: if false;
      }

      match /keywordHistory/{keywordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidKeywordHistoryCreate();
        allow update: if isOwner(userId) && isValidKeywordHistoryUpdate();
        allow delete: if false;
      }
    }

    match /notificationCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
