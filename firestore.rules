rules_version = '2';

// Collection: users/{userId}/keywordHistory/{keywordDocId}
// Deploy with: npx -y firebase-tools@latest deploy --only firestore:rules
// Console path: Firestore → Data → users/{uid}/keywordHistory

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /keywordHistory/{keywordId} {
        allow read: if isOwner(userId);

        // Create: required string fields + searchCount == 1.
        // topicId and timestamps are validated loosely so ServerTimestamp works.
        allow create: if isOwner(userId)
          && request.resource.data.keyword is string
          && request.resource.data.keyword.size() > 0
          && request.resource.data.keyword.size() <= 200
          && request.resource.data.normalizedKeyword is string
          && request.resource.data.normalizedKeyword.size() > 0
          && request.resource.data.searchCount is int
          && request.resource.data.searchCount == 1
          && request.resource.data.keys().hasAll([
               'keyword', 'normalizedKeyword', 'searchCount',
               'lastSearchedAt', 'firstSearchedAt'
             ])
          && request.resource.data.keys().hasOnly([
               'keyword', 'normalizedKeyword', 'topicId', 'searchCount',
               'lastSearchedAt', 'firstSearchedAt'
             ]);

        allow update: if isOwner(userId)
          && request.resource.data.keyword is string
          && request.resource.data.normalizedKeyword is string
          && request.resource.data.searchCount is int
          && request.resource.data.searchCount == resource.data.searchCount + 1
          && request.resource.data.keys().hasOnly([
               'keyword', 'normalizedKeyword', 'topicId', 'searchCount',
               'lastSearchedAt', 'firstSearchedAt'
             ]);

        allow delete: if false;
      }
    }
  }
}
