rules_version = '2';

// Deploy: npx -y firebase-tools@latest deploy --only firestore:rules
// Project: synapse-prm393
//
// Mobile paths:
//   users/{uid}/devices/{deviceId}       — FCM tokens (Profile open)
//   users/{uid}/keywordHistory/{id}      — search history
//   crashlyticsEvents/{id}               — Profile Crashlytics demo mirror
// Admin paths (Admin SDK bypasses rules; client admin reads only):
//   notificationCampaigns/{id}
//   adminAuditLogs/{id}

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // Profile screen registers the device FCM token here.
      match /devices/{deviceId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /keywordHistory/{keywordId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keyword is string
          && request.resource.data.keyword.size() > 0
          && request.resource.data.keyword.size() <= 200
          && request.resource.data.normalizedKeyword is string
          && request.resource.data.searchCount is int
          && request.resource.data.keys().hasOnly([
               'keyword', 'normalizedKeyword', 'topicId', 'searchCount',
               'lastSearchedAt', 'firstSearchedAt'
             ]);
        allow delete: if false;
      }
    }

    match /notificationCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Mirrored from the Profile Crashlytics demo (and admin status updates via Admin SDK).
    match /crashlyticsEvents/{eventId} {
      allow create: if request.resource.data.keys().hasOnly([
                       'title', 'exception', 'type', 'source', 'status',
                       'platform', 'uid', 'email', 'createdAt', 'updatedAt'
                     ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.exception is string
        && request.resource.data.exception.size() > 0
        && request.resource.data.exception.size() <= 1000
        && request.resource.data.type in ['nonfatal', 'fatal']
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 80
        && request.resource.data.status == 'open'
        && request.resource.data.platform in ['android', 'ios', 'web', 'other']
        && (request.resource.data.uid == null
            || (request.resource.data.uid is string
                && request.resource.data.uid.size() <= 128))
        && (request.resource.data.email == null
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 256))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!isSignedIn()
            || request.resource.data.uid == null
            || request.resource.data.uid == request.auth.uid);
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
